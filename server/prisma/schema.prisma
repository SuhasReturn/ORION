generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  candidateProfile CandidateProfile?
  jobPreferences   JobPreference[]
  applications     Application[]
  contacts         Contact[]
  outreach         Outreach[]
}

model CandidateProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String?
  email          String?
  phone          String?
  location       String?
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  education      String?
  degree         String?
  branch         String?
  graduationYear Int?
  cgpa           Float?
  resumePath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         Skill[]

  @@index([email])
}

model Skill {
  id        String             @id @default(cuid())
  name      String             @unique
  createdAt DateTime           @default(now())
  profiles  CandidateProfile[]
}

model JobPreference {
  id                 String   @id @default(cuid())
  userId             String
  desiredRoles       String?
  preferredLocations String?
  preferredWorkMode  String?
  minimumExperience  Int?
  maximumExperience  Int?
  minimumSalary      Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  website   String?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobs      Job[]
  contacts  Contact[]

  @@unique([name, website])
  @@index([name])
}

model Job {
  id           String        @id @default(cuid())
  companyId    String?
  title        String
  location     String?
  description  String?
  jobUrl       String?
  source       String        @default("manual")
  externalId   String?
  postedAt     DateTime?
  discoveredAt DateTime      @default(now())
  status       String        @default("discovered")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications Application[]
  contacts     Contact[]
  outreach     Outreach[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([status])
  @@index([discoveredAt])
}

model Contact {
  id        String     @id @default(cuid())
  userId    String
  companyId String?
  jobId     String?
  name      String
  role      String?
  type      String?
  profileUrl String?
  email     String?
  source    String?
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  outreach  Outreach[]
  followUps FollowUp[]

  @@index([userId])
  @@index([companyId])
  @@index([jobId])
  @@index([email])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("saved")
  appliedAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([status])
}

model Outreach {
  id             String     @id @default(cuid())
  userId         String
  jobId          String?
  contactId      String?
  channel        String
  message        String
  status         String     @default("draft")
  sentAt         DateTime?
  responseStatus String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  contact        Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUps      FollowUp[]

  @@index([userId])
  @@index([jobId])
  @@index([contactId])
  @@index([status])
}

model FollowUp {
  id          String    @id @default(cuid())
  outreachId  String?
  contactId   String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("scheduled")
  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  outreach    Outreach? @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([outreachId])
  @@index([contactId])
  @@index([scheduledAt])
  @@index([status])
}
