generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  candidateProfile CandidateProfile?
  jobPreference    JobPreference?
  applications     Application[]
  contacts         Contact[]
  outreach         Outreach[]
}

model CandidateProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  name           String?
  email          String?
  phone          String?
  location       String?
  linkedinUrl    String?
  githubUrl      String?
  portfolioUrl   String?
  education      String?
  degree         String?
  branch         String?
  university     String?
  graduationYear Int?
  cgpa           Float?
  experienceLevel String?
  currentRole    String?
  bio            String?
  resumePath     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         Skill[]

  @@index([email])
}

model Skill {
  id        String             @id @default(cuid())
  name      String             @unique
  createdAt DateTime           @default(now())
  profiles  CandidateProfile[]
  requiredFor JobPreferenceRequiredSkill[]
  preferredFor JobPreferencePreferredSkill[]
  jobs      Job[]
}

model JobPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  desiredRoles       String?
  preferredLocations String?
  preferredWorkMode  String?
  minimumExperience  Int?
  maximumExperience  Int?
  minimumSalary      Int?
  employmentType     String   @default("any")
  experienceLevel    String   @default("student")
  willingToRelocate  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles              JobPreferenceRole[]
  locations          JobPreferenceLocation[]
  industries         JobPreferenceIndustry[]
  requiredSkills     JobPreferenceRequiredSkill[]
  preferredSkills    JobPreferencePreferredSkill[]

  @@index([userId])
}

model JobPreferenceRole {
  id              String        @id @default(cuid())
  jobPreferenceId String
  value           String
  jobPreference   JobPreference @relation(fields: [jobPreferenceId], references: [id], onDelete: Cascade)

  @@unique([jobPreferenceId, value])
  @@index([value])
}

model JobPreferenceLocation {
  id              String        @id @default(cuid())
  jobPreferenceId String
  value           String
  jobPreference   JobPreference @relation(fields: [jobPreferenceId], references: [id], onDelete: Cascade)

  @@unique([jobPreferenceId, value])
  @@index([value])
}

model JobPreferenceIndustry {
  id              String        @id @default(cuid())
  jobPreferenceId String
  value           String
  jobPreference   JobPreference @relation(fields: [jobPreferenceId], references: [id], onDelete: Cascade)

  @@unique([jobPreferenceId, value])
  @@index([value])
}

model JobPreferenceRequiredSkill {
  jobPreferenceId String
  skillId         String
  jobPreference   JobPreference @relation(fields: [jobPreferenceId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPreferenceId, skillId])
  @@index([skillId])
}

model JobPreferencePreferredSkill {
  jobPreferenceId String
  skillId         String
  jobPreference   JobPreference @relation(fields: [jobPreferenceId], references: [id], onDelete: Cascade)
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobPreferenceId, skillId])
  @@index([skillId])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  website   String?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobs      Job[]
  contacts  Contact[]

  @@unique([name, website])
  @@index([name])
}

model Job {
  id           String        @id @default(cuid())
  companyId    String?
  title        String
  location     String?
  description  String?
  jobUrl       String?
  workMode     String?
  employmentType String?
  salaryText   String?
  source       String        @default("manual")
  externalId   String?
  postedAt     DateTime?
  discoveredAt DateTime      @default(now())
  status       String        @default("discovered")

  // Module 5: Normalization & Deduplication
  normalizedTitle          String?
  normalizedCompany        String?
  normalizedLocation       String?
  normalizedWorkMode       String?
  normalizedEmploymentType String?
  salaryMin                Float?
  salaryMax                Float?
  salaryCurrency           String?
  isDuplicate              Boolean       @default(false)
  duplicateConfidence      Float?
  duplicateReason          String?
  canonicalJobId           String?
  canonicalJob             Job?          @relation("JobDuplicates", fields: [canonicalJobId], references: [id], onDelete: SetNull)
  duplicateJobs            Job[]         @relation("JobDuplicates")
  skills                   Skill[]

  // Module 6: Job Filtering
  filterStatus             String        @default("pending")
  filterReasons            String?

  // Module 7: Matching & Scoring
  matchScore               Float?
  matchRating              String?
  matchReasons             String?
  matchedSkills            String?
  missingSkills            String?

  // Module 8: Local AI / Ollama
  aiSummary                String?
  aiMatchExplanation       String?
  aiProcessedAt            DateTime?

  // Module 9: Job CRM
  isSaved                  Boolean       @default(false)
  notes                    String?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications Application[]
  contacts     Contact[]
  outreach     Outreach[]

  @@unique([source, externalId])
  @@index([companyId])
  @@index([status])
  @@index([discoveredAt])
  @@index([canonicalJobId])
  @@index([filterStatus])
  @@index([matchScore])
  @@index([isSaved])
}

model Contact {
  id        String     @id @default(cuid())
  userId    String
  companyId String?
  jobId     String?
  name      String
  role      String?
  type      String?
  profileUrl String?
  email     String?
  phone     String?
  notes     String?
  source    String?
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  job       Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  outreach  Outreach[]
  followUps FollowUp[]

  @@index([userId])
  @@index([companyId])
  @@index([jobId])
  @@index([email])
}

model Application {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  status    String   @default("saved")
  appliedAt DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([status])
}

model Outreach {
  id             String     @id @default(cuid())
  userId         String
  jobId          String?
  contactId      String?
  channel        String
  message        String
  status         String     @default("draft")
  sentAt         DateTime?
  responseStatus String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?       @relation(fields: [jobId], references: [id], onDelete: SetNull)
  contact        Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  followUps      FollowUp[]

  @@index([userId])
  @@index([jobId])
  @@index([contactId])
  @@index([status])
}

model FollowUp {
  id          String    @id @default(cuid())
  outreachId  String?
  contactId   String?
  scheduledAt DateTime
  sentAt      DateTime?
  status      String    @default("scheduled")
  message     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  outreach    Outreach? @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([outreachId])
  @@index([contactId])
  @@index([scheduledAt])
  @@index([status])
}
